{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Baa",
  "scopeName": "source.baa",
  "patterns": [
    {
      "include": "#raw-block-strings"
    },
    {
      "include": "#raw-strings"
    },
    {
      "include": "#block-strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.baa",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.baa",
          "match": "//.*$"
        },
        {
          "name": "comment.block.baa",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.baa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.baa",
          "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|[ntr0e\\\\\"{}])"
        },
        {
          "name": "invalid.illegal.unknown-escape.baa",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.interpolation.baa",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.baa"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.baa"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.baa",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.baa",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.baa",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.baa",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.baa"
            },
            "2": {
              "name": "entity.name.function.baa"
            }
          }
        },
        {
          "match": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.baa"
            },
            "2": {
              "name": "variable.other.declaration.baa"
            }
          }
        },
        {
          "match": "\\b(test)\\s+(?=\")",
          "captures": {
            "1": {
              "name": "keyword.control.test.baa"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.baa",
          "match": "\\b(if|else|while|for|in|break|continue|return|match|try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.other.baa",
          "match": "\\b(import|export|as|from|test)\\b"
        },
        {
          "name": "storage.type.baa",
          "match": "\\b(let|const|fn)\\b"
        },
        {
          "name": "keyword.other.baa.print",
          "match": "\\bbaa\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.baa",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "support.function.builtin.baa",
          "match": "\\b(len|type_of|to_string|to_number|inspect|clone|assert|assert_eq|panic|exit)\\b(?=\\s*\\()"
        },
        {
          "name": "variable.other.constant.baa",
          "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
        }
      ]
    },
    "modules": {
      "name": "support.class.module.baa",
      "match": "\\b(wool|flock|ram|meadow|pasture|shepherd|lamb)\\b(?=\\.)"
    },
    "calls": {
      "patterns": [
        {
          "match": "\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.method.baa"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.baa"
            }
          }
        },
        {
          "match": "\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.property.baa"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.baa",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.assignment.baa",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.baa",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.baa",
          "match": "(&&|\\|\\||\\?\\?|!)"
        },
        {
          "name": "keyword.operator.arithmetic.baa",
          "match": "(\\*\\*|[+\\-*/%])"
        },
        {
          "name": "keyword.operator.arrow.baa",
          "match": "=>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.baa",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.section.braces.baa",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.baa",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.baa",
          "match": "[()]"
        }
      ]
    },
    "block-strings": {
      "name": "string.quoted.triple.baa",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "constant.character.escape.baa",
          "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|[ntr0e\\\\\"{}])"
        },
        {
          "name": "invalid.illegal.unknown-escape.baa",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.interpolation.baa",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.baa"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.baa"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "raw-strings": {
      "name": "string.quoted.double.raw.baa",
      "begin": "r\"",
      "end": "\"",
      "patterns": []
    },
    "raw-block-strings": {
      "name": "string.quoted.triple.raw.baa",
      "begin": "r\"\"\"",
      "end": "\"\"\"",
      "patterns": []
    }
  }
}

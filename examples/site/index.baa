/// The home page.
///
///     baa serve examples/site
///     open http://localhost:8080/
///
/// Every request runs this file. `gate` reads the request out of the CGI
/// environment and writes the reply to standard output, which is what Apache,
/// nginx and `baa serve` all expect from a page.

import gate
import wool
import pasture
import shepherd
import { base, page } from "./layout.baa"

const flock = ["Dolly", "Shaun", "Timmy", "Shirley"]

// `gate.format` escapes each value it puts into a `%s`. That is the whole
// reason it exists: `name` came from the query string, so it is the visitor's
// text, not ours.
const name = gate.query().get("name", "world")

const items = flock.map(fn(sheep) {
    return gate.format("<li><a href=\"%ssheep.baa/%s\">%s</a></li>", base(), sheep, sheep)
}).join("\n")

/// Applications published beside this page, discovered rather than listed.
///
/// CGI sets `SCRIPT_FILENAME` to the file being run, so a page can find its
/// own directory and look at what is next to it. A directory under `apps/`
/// counts as an application when it has an `index.baa` to answer with.
fn applications() {
    const script = shepherd.env("SCRIPT_FILENAME") ?? ""
    if script == "" {
        return []
    }
    const root = pasture.join(pasture.dir_name(script), "apps")
    if !pasture.exists(root) {
        return []
    }
    const found = []
    for name in pasture.list(root) {
        const entry = pasture.join(root, name, "index.baa")
        if pasture.exists(entry) {
            found.push({ name: name, title: title_of(entry, name) })
        }
    }
    // Sorted by the name each application gives itself.
    //
    // The comparator is bound first rather than written inline: newlines are
    // suppressed inside an unclosed `(`, so a function literal with more than
    // one statement in it cannot be an argument (SPEC 2.2).
    return found.sort(by_title)
}

/// `fn` declarations are hoisted; `const` bindings are not, so this is a
/// declaration rather than a binding and can be written after its use.
fn by_title(a, b) {
    if a.title < b.title {
        return -1
    }
    if a.title > b.title {
        return 1
    }
    return 0
}

/// An application's own name, taken from the `<title>` of its page.
///
/// Deriving one from the directory gets "Json Viewer" out of "json-viewer",
/// and a list of acronyms to special-case is a list somebody has to maintain.
/// The page already knows what it is called, so it is asked.
fn title_of(entry, fallback) {
    const source = pasture.read(entry)
    const opening = source.index_of("<title>")
    if opening < 0 {
        return fallback
    }
    const rest = source.slice(opening + 7)
    const closing = rest.index_of("</title>")
    if closing < 0 {
        return fallback
    }
    return rest.slice(0, closing).trim()
}

const apps = applications()
let apps_html = ""
if apps.length() > 0 {
    apps_html = "<h2>Applications</h2><p>Written in Baa, running here. Each one is a"
    apps_html += " program that answers a request; none of them contains any JavaScript.</p><ul>"
    for app in apps {
        apps_html += gate.format("<li><a href=\"%sapps/%s/\">%s</a></li>", base(), app.name, app.title)
    }
    apps_html += "</ul>"
}

gate.html(
    page(
        "Baa",
        wool.concat(
            gate.format("<h1>Baa, %s!</h1>", name),
            "<p>This page is a Baa program. It ran when you asked for it.</p>",
            "<form><label>Your name <input name=\"name\"></label> <button>Say baa</button></form>",
            "<h2>The flock</h2><ul>",
            items,
            gate.format("</ul><p><a href=\"%scount.baa\">Count some sheep</a></p>", base()),
            apps_html,
        ),
    ),
)

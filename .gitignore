node_modules/
dist/
*.log
.DS_Store
Thumbs.db
baa.lock
.baa-cache/
# The website's sources are tracked; its built output is not. The pages are
# deployed to sheep.grimtech.co.uk, so committing them here would keep a second
# copy of something a generator in tools/ rebuilds from scratch on demand.
#
# Tracked: website/src/, the hand-written assets (playground, worker, shims,
# styles, theme, highlight), the SVG drawings, and the Apache configuration.
# The playground's browser build lives here, so a clone can build and test it.
website/*.html
website/docs/
website/baa/
website/sitemap.xml
website/llms.txt
website/llms-full.txt
website/assets/baa/
website/assets/*.png

# Rust build output. The native runtime's source lives in rust/crates/; its
# target directory is several hundred megabytes of intermediate objects and is
# rebuilt from source by `cargo build`.
rust/target/
**/*.rs.bk
*.pdb

# Built native applications: `baa app build` writes here, and an executable is
# a build artefact like any other.
build/
*.fleece

# The VS Code extension is compiled from editors/vscode/src and packaged into
# a .vsix. Both are build artefacts; the sources and the lockfile are not.
editors/vscode/out/
editors/vscode/*.vsix

# The integration test downloads its own VS Code, which is a third of a
# gigabyte. It is a cache, not a dependency.
.vscode-test/
editors/vscode/.vscode-test/

# Scratch .baa files for eyeballing the editor. Deliberately broken, so they
# would fail the formatter and linter that run over examples/ and
# tests/programs/. Local only.
sandbox/
